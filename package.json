{
  "name": "golfballs-extension",
  "private": true,
  "version": "3.4.0",
  "type": "module",
  "description": "Golfballs.com Sales Toolkit — Chrome extension layering email/proposal, CRM workflow, and order tools onto the golfballs.com admin CRM. See README.md.",
  "scripts": {
    "prebuild": "npm run help-content",
    "build": "node --max-old-space-size=8192 build.js",
    "watch": "node --max-old-space-size=8192 build.js --watch",
    "audit": "node scripts/audit-source.mjs",
    "help-content": "node scripts/build-help-content.mjs",
    "remote-config": "node scripts/build-remote-settings-config.mjs",
    "remote-config:legacy-seed": "node scripts/build-remote-settings-config.mjs --legacy-seed",
    "pack:store": "GB_ADMIN=0 node --max-old-space-size=4096 scripts/package-store.mjs",
    "pretest": "npm run help-content",
    "test": "npm run test:security && npm run test:auth-broker && npm run test:crm-index && npm run test:installation && npm run test:remote-policy && npm run test:contact-import && npm run test:employee-identity && npm run test:sharing-fallback && npm run test:remote-integrity && npm run test:backend-integration && npm run test:unit && npm run test:integration",
    "test:security": "node scripts/test-security.mjs",
    "test:auth-broker": "node scripts/test-auth-session-broker.mjs",
    "test:crm-index": "node scripts/test-crm-index-encryption.mjs",
    "test:installation": "node scripts/test-installation-auth.mjs",
    "test:remote-policy": "node scripts/test-remote-settings-policy.mjs",
    "test:contact-import": "node scripts/test-contact-import.mjs",
    "test:employee-identity": "node scripts/test-employee-identity.mjs",
    "test:sharing-fallback": "node scripts/test-sharing-fallback.mjs",
    "test:remote-integrity": "node scripts/test-remote-integrity.mjs",
    "test:backend-integration": "node scripts/test-backend-integration.mjs",
    "test:unit": "node --test \"tests/unit/*.test.mjs\"",
    "test:integration": "node --test \"tests/integration/*.test.mjs\"",
    "check": "npm run audit && npm test && npm run build"
  },
  "tests": [
    { "name": "email · MIME/EML parsing → renderable HTML", "file": "tests/unit/emailParse.test.mjs" },
    { "name": "email · composer slash-command templates", "file": "tests/unit/emailComposerCommands.test.mjs" },
    { "name": "email · contact-page composer transport", "file": "tests/unit/contactEmail.test.mjs" },
    { "name": "email · clicked-thread reply routing", "file": "tests/unit/emailReply.test.mjs" },
    { "name": "email · signature, plain-text & mailto/PA payloads", "file": "tests/unit/emailSender.test.mjs" },
    { "name": "email · HTML sanitizer strips scripts & bypasses", "file": "tests/unit/sanitizeHtml.test.mjs" },
    { "name": "email · proposal email rows & cart links", "file": "tests/unit/proposalEmailSource.test.mjs" },
    { "name": "email · template import validation", "file": "tests/unit/templateImport.test.mjs" },
    { "name": "email · legacy template migration", "file": "tests/unit/templateMigration.test.mjs" },
    { "name": "modal · charge amounts, payloads & approval loop", "file": "tests/unit/chargeModal.test.mjs" },
    { "name": "modal · order-edit math & cart iframe", "file": "tests/unit/orderEditModal.test.mjs" },
    { "name": "modal · call-log submit contract", "file": "tests/unit/submitCallLog.test.mjs" },
    { "name": "modal · quick-task create payload", "file": "tests/unit/submitQuickTask.test.mjs" },
    { "name": "modal · quick order-note templates & last-note action", "file": "tests/unit/quickOrderNote.test.mjs" },
    { "name": "modal · order-date calendar relay", "file": "tests/unit/submitOrderDates.test.mjs" },
    { "name": "modal · case category read-merge-write", "file": "tests/unit/submitCaseCategory.test.mjs" },
    { "name": "crm · task list parse & complete write-back", "file": "tests/unit/crmTasks.test.mjs" },
    { "name": "crm · indexed search ranking", "file": "tests/unit/crmIndex.test.mjs" },
    { "name": "crm · case rule matching & recommendations", "file": "tests/unit/caseMatch.test.mjs" },
    { "name": "crm · match-engine operators & trees", "file": "tests/unit/matchEngine.test.mjs" },
    { "name": "crm · template variables & conditionals", "file": "tests/unit/variableResolution.test.mjs" },
    { "name": "email · full variable editing and attachments", "file": "tests/unit/templateVariableEditing.test.mjs" },
    { "name": "crm · chat transcript parsing", "file": "tests/unit/parseChat.test.mjs" },
    { "name": "crm · phone extraction from orders", "file": "tests/unit/findPhone.test.mjs" },
    { "name": "crm · call categories & templates", "file": "tests/unit/callLog.test.mjs" },
    { "name": "crm · task priorities & due labels", "file": "tests/unit/quickTask.test.mjs" },
    { "name": "crm · task category labels", "file": "tests/unit/taskCategories.test.mjs" },
    { "name": "crm · recent-orders scan contract", "file": "tests/unit/recentOrdersScan.test.mjs" },
    { "name": "money · catalog pricing & usd formatting", "file": "tests/unit/giftCatalogMath.test.mjs" },
    { "name": "money · bundle packing & ball costs", "file": "tests/unit/bundleCost.test.mjs" },
    { "name": "money · margin math & cost basis", "file": "tests/unit/marginReport.test.mjs" },
    { "name": "money · cart & preview URL serialization", "file": "tests/unit/cartSerializer.test.mjs" },
    { "name": "ui · display scales clamp & persist", "file": "tests/unit/scales.test.mjs" },
    { "name": "ui · Actions Shelf panel motion", "file": "tests/unit/shelfMotion.test.mjs" },
    { "name": "ui · Help Companion conversation state", "file": "tests/unit/helpChatState.test.mjs" },
    { "name": "ui · Help Companion composer sizing", "file": "tests/unit/helpComposer.test.mjs" },
    { "name": "ui · Help Companion waiting runner", "file": "tests/unit/helpWaitingGame.test.mjs" },
    { "name": "ui · Help Companion guarded actions", "file": "tests/unit/helpActionCore.test.mjs" },
    { "name": "ui · Help Companion automatic settings context", "file": "tests/unit/helpActions.test.mjs" },
    { "name": "guard · Help Companion approved local data", "file": "tests/unit/helpDataAccess.test.mjs" },
    { "name": "guard · authenticated extension bootstrap", "file": "tests/unit/extensionAccessGate.test.mjs" },
    { "name": "guard · database-backed installation access", "id": "guard-installation-access", "command": ["../.venv/bin/python", "tests/test_extension_client_api.py"] },
    { "name": "guard · database-backed settings policy", "id": "guard-settings-policy", "command": ["../.venv/bin/python", "tests/test_settings_policy.py"] },
    { "name": "ui · managed Settings section visibility", "file": "tests/unit/manageSections.test.mjs" },
    { "name": "ui · ASP date offsets & calendar cells", "file": "tests/unit/dateUtils.test.mjs" },
    { "name": "ui · admin page-context routing", "file": "tests/unit/pageContext.test.mjs" },
    { "name": "guard · operator-guide content coverage", "file": "tests/unit/helpContent.test.mjs" },
    { "name": "guard · AI help knowledge corpus", "id": "guard-help-agent", "command": ["../.venv/bin/python", "tests/test_help_agent.py"] },
    { "name": "flow · ASP.NET calendar form-state reconstruction", "file": "tests/unit/calendarFormState.test.mjs" },
    { "name": "flow · install enrollment lifecycle", "file": "tests/integration/enrollment-lifecycle.test.mjs" },
    { "name": "ui · one-time installation identity confirmation", "file": "tests/unit/installationIdentityNotice.test.mjs" },
    { "name": "flow · api fetch guard & bearer auth", "file": "tests/integration/api-guard-flow.test.mjs" },
    { "name": "flow · Help Companion background recovery", "file": "tests/integration/help-assistant-flow.test.mjs" },
    { "name": "flow · assistant support ticket lifecycle", "file": "tests/integration/support-ticket-lifecycle.test.mjs" },
    { "name": "flow · settings share create→import→revoke", "file": "tests/integration/settings-share-lifecycle.test.mjs" },
    { "name": "flow · email template share links", "file": "tests/integration/template-share-import.test.mjs" },
    { "name": "flow · remote settings policy sync", "file": "tests/integration/remote-policy-sync.test.mjs" },
    { "name": "flow · eml → sanitize → send pipeline", "file": "tests/integration/email-pipeline.test.mjs" },
    { "name": "flow · charge endpoint security guard", "file": "tests/integration/charge-guard.test.mjs" },
    { "name": "flow · order-note modal → authenticated iframe", "file": "tests/integration/order-note-relay.test.mjs" },
    { "name": "flow · encrypted crm index roundtrip", "file": "tests/integration/crm-index-roundtrip.test.mjs" },
    { "name": "flow · chrome update channel chain", "file": "tests/integration/update-channel.test.mjs" },
    { "name": "guard · browser-store ZIP safety and determinism", "file": "tests/integration/store-packaging.test.mjs" },
    { "name": "guard · security policy allowlists", "id": "guard-security", "command": ["node", "scripts/test-security.mjs"] },
    { "name": "guard · auth session broker", "id": "guard-auth-broker", "command": ["node", "scripts/test-auth-session-broker.mjs"] },
    { "name": "guard · crm index encryption", "id": "guard-crm-index", "command": ["node", "scripts/test-crm-index-encryption.mjs"] },
    { "name": "guard · installation enrollment", "id": "guard-installation", "command": ["node", "scripts/test-installation-auth.mjs"] },
    { "name": "guard · remote settings policy", "id": "guard-remote-policy", "command": ["node", "scripts/test-remote-settings-policy.mjs"] },
    { "name": "guard · contact import", "id": "guard-contact-import", "command": ["node", "scripts/test-contact-import.mjs"] },
    { "name": "guard · employee identity", "id": "guard-employee-identity", "command": ["node", "scripts/test-employee-identity.mjs"] },
    { "name": "guard · sharing fallback", "id": "guard-sharing-fallback", "command": ["node", "scripts/test-sharing-fallback.mjs"] },
    { "name": "remote · update-channel integrity", "id": "remote-integrity", "command": ["node", "scripts/test-remote-integrity.mjs"] },
    { "name": "remote · backend api contract", "id": "backend-contract", "command": ["node", "scripts/test-backend-integration.mjs"] }
  ],
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "jsdom": "^27.0.1",
    "vite": "^6.0.0"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.10.3",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.12.3",
    "@codemirror/lint": "^6.9.6",
    "@codemirror/state": "^6.6.0",
    "@codemirror/view": "^6.43.0",
    "cannon-es": "^0.20.0",
    "motion": "^12.40.0",
    "react": "^18.3.1",
    "react-beautiful-color": "^2.1.0",
    "react-dom": "^18.3.1",
    "three": "^0.184.0"
  }
}
