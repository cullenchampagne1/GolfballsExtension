{
  "manifest_version": 3,
  "name": "Golfballs.com Sales Toolkit",
  "key": "",
  "update_url": "https://api.cullenchampagne.com/projects/golfballs-extension/updates.xml",
  "version": "3.4.1",
  "description": "Email, proposal, CRM-workflow, and order tools for the golfballs.com admin CRM.",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "clipboardWrite",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://www.golfballs.com/*",
    "https://api.golfballs.com/*",
    "https://static.golfballs.com/*",
    "https://www.icustomize.com/*",
    "https://admin.icustomize.com/*",
    "https://master.api.icustomize.com/*",
    "https://production-private-api.icustomize.com/*",
    "https://office.gbcadmin.com/*",
    "https://operations.gbcadmin.com/*",
    "https://snugzusa.com/*",
    "https://*.snugzusa.com/*",
    "https://hpgbrands.com/*",
    "https://*.hpgbrands.com/*",
    "https://www.customizationapplications.com/*",
    "https://s.customizationapps.com/*",
    "https://d1tp32r8b76g0z.cloudfront.net/*",
    "https://brmth7.a.searchspring.io/*",
    "https://7uyieah5s5.execute-api.us-east-2.amazonaws.com/dev/convert",
    "https://51grploz6a.execute-api.us-east-2.amazonaws.com/production/admin/recordNote",
    "https://s3.amazonaws.com/*",
    "https://s3.us-east-2.amazonaws.com/*",
    "https://*.s3.amazonaws.com/*",
    "https://*.s3.us-east-2.amazonaws.com/*",
    "https://us-autocomplete-pro.api.smartystreets.com/*",
    "https://*.logic.azure.com/*",
    "https://*.environment.api.powerplatform.com/*",
    "https://api.cullenchampagne.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["editor.html", "sandbox.html", "react-dist/sandbox/sandbox-eval.js"],
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*",
        "https://admin.icustomize.com/*",
        "https://www.icustomize.com/*"
      ]
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'none'; img-src 'none'; style-src 'none'; font-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; form-action 'none'; base-uri 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
