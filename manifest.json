{
  "manifest_version": 3,
  "name": "Golfballs.com Sales Toolkit",
  "key": "",
  "update_url": "https://api.cullenchampagne.com/projects/golfballs-extension/updates.xml",
  "version": "3.4.14",
  "description": "Email, proposal, CRM-workflow, and order tools for the golfballs.com admin CRM.",
  "permissions": [
    "scripting",
    "storage",
    "unlimitedStorage",
    "tabs",
    "clipboardWrite",
    "declarativeNetRequest",
    "alarms"
  ],
  "host_permissions": [
    "https://www.golfballs.com/*",
    "https://api.golfballs.com/*",
    "https://static.golfballs.com/*",
    "https://www.icustomize.com/*",
    "https://admin.icustomize.com/*",
    "https://master.api.icustomize.com/*",
    "https://production-private-api.icustomize.com/*",
    "https://office.gbcadmin.com/*",
    "https://operations.gbcadmin.com/*",
    "https://snugzusa.com/*",
    "https://*.snugzusa.com/*",
    "https://hpgbrands.com/*",
    "https://*.hpgbrands.com/*",
    "https://www.customizationapplications.com/*",
    "https://s.customizationapps.com/*",
    "https://d1tp32r8b76g0z.cloudfront.net/*",
    "https://brmth7.a.searchspring.io/*",
    "https://7uyieah5s5.execute-api.us-east-2.amazonaws.com/dev/convert",
    "https://51grploz6a.execute-api.us-east-2.amazonaws.com/production/admin/recordNote",
    "https://s3.amazonaws.com/*",
    "https://s3.us-east-2.amazonaws.com/*",
    "https://*.s3.amazonaws.com/*",
    "https://*.s3.us-east-2.amazonaws.com/*",
    "https://us-autocomplete-pro.api.smartystreets.com/*",
    "https://*.logic.azure.com/*",
    "https://*.environment.api.powerplatform.com/*",
    "https://api.cullenchampagne.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "editor.html",
        "sandbox.html",
        "react-dist/sandbox/sandbox-eval.js"
      ],
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*",
        "https://admin.icustomize.com/*",
        "https://www.icustomize.com/*"
      ]
    }
  ],
  "sandbox": {
    "pages": [
      "sandbox.html"
    ]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; default-src 'none'; script-src 'self' 'unsafe-eval'; connect-src 'none'; img-src 'none'; style-src 'none'; font-src 'none'; media-src 'none'; object-src 'none'; frame-src 'none'; worker-src 'none'; form-action 'none'; base-uri 'none';"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*"
      ],
      "js": [
        "src/vanilla/custom-page-boot.js"
      ],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*"
      ],
      "js": [
        "src/vanilla/custom-page-host-bridge.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*"
      ],
      "js": [
        "theme.js",
        "lib/action-language.js",
        "lib/action-runtime.js",
        "react-dist/vanilla/user-context.js",
        "react-dist/vanilla/three-runtime.js",
        "src/vanilla/smart-detection.js",
        "react-dist/vanilla/page-engine.js",
        "src/vanilla/variable-resolution.js",
        "react-dist/content/image-preview.js",
        "react-dist/content/submit-proof.js",
        "react-dist/content/gift-catalog.js",
        "react-dist/content/mockup-studio.js",
        "src/vanilla/usage-report.js",
        "src/vanilla/modals/modal-chrome.js",
        "src/vanilla/modals/charge-modal.js",
        "src/vanilla/modals/order-edit-modal.js",
        "src/vanilla/page-utils.js",
        "react-dist/content/email-preview.js",
        "react-dist/content/text-preview.js",
        "react-dist/content/watch-list.js",
        "react-dist/content/notifications.js",
        "react-dist/content/workflow-manager.js",
        "react-dist/content/task-list.js",
        "react-dist/content/call-log.js",
        "react-dist/content/quick-task.js",
        "react-dist/content/quick-order-note.js",
        "react-dist/content/margin-calc.js",
        "react-dist/content/crm-search.js",
        "react-dist/content/crm-create-contact.js",
        "react-dist/content/actions-shelf.js",
        "react-dist/content/calendar.js",
        "react-dist/content/proposal-debug.js",
        "react-dist/content/contact-details.js",
        "react-dist/content/account-details.js",
        "react-dist/content/opportunity-details.js",
        "react-dist/content/crm-search-page.js",
        "react-dist/content/crm-task-list-page.js",
        "react-dist/content/crm-recent-history-page.js",
        "react-dist/content/crm-action-review-page.js",
        "react-dist/content/crm-replacement-contacts-page.js",
        "src/vanilla/custom-pages.js",
        "src/vanilla/main.js"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "https://api.golfballs.com/*"
      ],
      "js": [
        "react-dist/vanilla/recent-orders-sweep.js",
        "react-dist/vanilla/bounce-flag.js"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "https://admin.icustomize.com/*"
      ],
      "js": [
        "iframe/auth-session-broker.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://admin.icustomize.com/*"
      ],
      "js": [
        "theme.js",
        "calendar-form-state.js",
        "iframe/message-bridge.js",
        "iframe/note-sender.js",
        "iframe/date-utils.js",
        "iframe/calendar-bridge.js",
        "iframe/toolbar.js"
      ],
      "css": [
        "theme.css"
      ],
      "all_frames": true
    },
    {
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*",
        "https://office.gbcadmin.com/*",
        "https://operations.gbcadmin.com/*"
      ],
      "js": [
        "src/vanilla/proposal-net-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://office.gbcadmin.com/*",
        "https://operations.gbcadmin.com/*"
      ],
      "js": [
        "theme.js",
        "react-dist/content/proposal-debug.js"
      ],
      "all_frames": false
    },
    {
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*",
        "https://office.gbcadmin.com/*",
        "https://operations.gbcadmin.com/*"
      ],
      "js": [
        "src/vanilla/tracker-net-hook.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.golfballs.com/*",
        "https://api.golfballs.com/*",
        "https://office.gbcadmin.com/*",
        "https://operations.gbcadmin.com/*"
      ],
      "js": [
        "src/vanilla/tracker-bridge.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
