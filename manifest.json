{
  "manifest_version": 3,
  "name": "Golfballs.com Sales Toolkit",
  "version": "3.3",
  "description": "Email, proposal, CRM-workflow, and order tools for the golfballs.com admin CRM.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage",
    "theme",
    "unlimitedStorage",
    "tabs",
    "clipboardWrite",
    "webNavigation",
    "identity",
    "downloads",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "*://*.golfballs.com/*",
    "*://*.icustomize.com/*",
    "*://*.gbcadmin.com/*",
    "*://snugzusa.com/*",
    "*://*.snugzusa.com/*",
    "*://hpgbrands.com/*",
    "*://*.hpgbrands.com/*",
    "*://*.customizationapplications.com/*",
    "http://s.customizationapps.com/*",
    "https://s.customizationapps.com/*",
    "https://d1tp32r8b76g0z.cloudfront.net/*",
    "https://brmth7.a.searchspring.io/*",
    "https://*.execute-api.us-east-2.amazonaws.com/*",
    "https://s3.amazonaws.com/*",
    "https://s3.us-east-2.amazonaws.com/*",
    "https://*.s3.amazonaws.com/*",
    "https://*.s3.us-east-2.amazonaws.com/*",
    "https://graph.microsoft.com/*",
    "https://login.microsoftonline.com/*",
    "https://us-autocomplete-pro.api.smartystreets.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["editor.html", "playground.html", "custom-pages-sandbox.html", "sandbox.html", "react-dist/sandbox/sandbox-eval.js", "assets/photo_ball.jpg", "assets/golfball_model/Golf_ball.obj", "assets/poker_chip_model/PokerChip.obj", "assets/divot_tool_model/DivotTool.obj", "assets/bartender_tool_model/BartenderTool.obj", "assets/marker_model/BallMarker.obj", "assets/giftbox_model/GiftBox.obj", "assets/giftbox_model/GiftBox_Lever.obj", "assets/giftbox_model/GiftBox_Bartender.obj", "assets/giftbox_model/GiftBox_WoodPoker.obj", "assets/giftbox_model/GiftBox_WoodLever.obj", "assets/giftbox_model/wood_diff.jpg", "assets/metal_texture/worn_metal_rough.jpg", "assets/metal_texture/worn_metal_normal.png", "assets/tee_model/Tee.obj", "assets/golden_gate_hills_4k.exr", "assets/lilienstein_4k.exr", "assets/moonlit_golf_4k.exr", "assets/sunset_fairway_4k.exr", "assets/mockup_base.png"],
      "matches": ["*://*.golfballs.com/*", "*://*.icustomize.com/*"]
    }
  ],
  "sandbox": {
    "pages": ["sandbox.html"]
  },
  "content_security_policy": {
    "sandbox": "sandbox allow-scripts; script-src 'self' 'unsafe-eval'; child-src 'self';"
  },
  "content_scripts": [
    {
      "matches": ["*://*.golfballs.com/*"],
      "js": ["src/vanilla/custom-page-boot.js"],
      "run_at": "document_start",
      "all_frames": false
    },
    {
      "matches": ["*://*.golfballs.com/*"],
      "js": [
        "theme.js",
        "src/vanilla/smart-detection.js",
        "react-dist/vanilla/page-engine.js",
        "src/vanilla/variable-resolution.js",
        "react-dist/content/image-preview.js",
        "react-dist/content/submit-proof.js",
        "react-dist/content/gift-catalog.js",
        "src/vanilla/modals/charge-modal.js",
        "src/vanilla/modals/order-edit-modal.js",
        "src/vanilla/page-utils.js",
        "react-dist/content/email-preview.js",
        "react-dist/content/text-preview.js",
        "react-dist/content/watch-list.js",
        "react-dist/content/campaign-manager.js",
        "react-dist/content/task-list.js",
        "react-dist/content/call-log.js",
        "react-dist/content/quick-task.js",
        "react-dist/content/margin-calc.js",
        "react-dist/content/crm-search.js",
        "react-dist/content/crm-create-contact.js",
        "react-dist/content/actions-shelf.js",
        "react-dist/content/calendar.js",
        "react-dist/content/proposal-debug.js",
        "react-dist/content/contact-details.js",
        "react-dist/content/account-details.js",
        "src/vanilla/custom-pages.js",
        "src/vanilla/main.js"
      ],
      "all_frames": false
    },
    {
      "matches": ["*://admin.icustomize.com/*"],
      "js": [
        "theme.js",
        "iframe/note-sender.js",
        "iframe/date-utils.js",
        "iframe/calendar-bridge.js",
        "iframe/toolbar.js"
      ],
      "css": ["theme.css"],
      "all_frames": true
    },
    {
      "matches": ["*://*.golfballs.com/*", "*://*.gbcadmin.com/*"],
      "js": ["src/vanilla/proposal-net-hook.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": ["*://*.gbcadmin.com/*"],
      "js": ["theme.js", "react-dist/content/proposal-debug.js"],
      "all_frames": false
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
