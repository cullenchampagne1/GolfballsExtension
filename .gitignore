# Installed dependencies are reproducible from package-lock.json.
node_modules/

# Operating-system and editor state.
.DS_Store
**/.DS_Store
.claude/settings.local.json
*.log

# Local test and coverage output.
coverage/
.nyc_output/
.pytest_cache/
__pycache__/
*.pyc

# Ad-hoc export/submission artifacts (Power Automate flow zips, manual
# submission bundles) — the store zip is built to dist/store/ by pack:store.
/*.zip

# Browser captures can contain authenticated request headers and customer data.
*.har

# Local credentials and signing material must never enter version control.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Extension release channel state (1GB+ workspace, signing key, published CRXs)
# — managed by ./golfballs, never versioned.
.golfballs-extension-production/
dist/store-stage/
dist/store/

# Backend integration — lives on the local backend machine only, never in the
# shared extension source (loaded by the RevStack backend's ProjectManager).
.revstack/
revstack.project.json
golfballs

# Admin/consumer strip config — builds run on the server, not from the shared source.
admin-only.json
