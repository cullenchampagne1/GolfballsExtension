# Installed dependencies are reproducible from package-lock.json.
node_modules/

# Operating-system and editor state.
.DS_Store
**/.DS_Store
.claude/settings.local.json
*.log

# Local test and coverage output.
coverage/
.nyc_output/
.pytest_cache/
__pycache__/
*.pyc

# Ad-hoc export/submission artifacts (Power Automate flow zips, manual
# submission bundles) — the store zip is built to dist/store/ by pack:store.
/*.zip

# Browser captures can contain authenticated request headers and customer data.
*.har

# Local credentials and signing material must never enter version control.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Extension release channel state (1GB+ workspace, signing key, published CRXs)
# — managed by ./golfballs, never versioned.
.golfballs-extension-production/
dist/store-stage/
dist/store/

# Project-owned RevStack integration, release tooling, and consumer packaging
# policy are versioned with the extension. Runtime release state and signing
# material remain isolated above in .golfballs-extension-production/.
dist/safari/
dist/safari-stage/

# RevStack backend integration is LOCAL-ONLY. The backend loads .revstack/ and
# revstack.project.json from disk to mount this project, but they are not part
# of the public consumer extension repo and must never be pushed. Untracked via
# `git rm --cached` (files remain on disk, so the backend keeps working).
.revstack/
/revstack.project.json
.revstack-runtime/
