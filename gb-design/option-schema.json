        { "type": "textLine", "label": "Line 1", "note": "the initials text" },
        { "type": "colorPicker", "label": "Color 1", "palette": "enumerations.colorPalette", "default": "Black" },
        { "type": "colorPicker", "label": "Color 2", "palette": "enumerations.colorPalette", "addsTransparent": true, "default": "Transparent" }
