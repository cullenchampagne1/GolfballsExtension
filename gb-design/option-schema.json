{
  "_comment": "Scratch artifact for golfballs payment extension. Maps modificationName_ss values -> control schemas, and item-type groups -> supported modifications. Source: live UI inspection + full Solr catalog (969 products). Not committed to repo.",
  "decisionField": "modificationName_ss",
  "note": "background.js fetchGiftCatalog already returns modificationName_ss; giftCatalog.js:142 currently reduces it to a count. Keep the array to drive this schema.",
  "lens": "Map options from the Custom Logo entry point the extension uses (modificationName_ss:\"Custom Logo\"), NOT the bare consumer default a product URL opens on. Modifications flagged corporateScope:false are consumer-only golf-ball print types reachable only on a ball's bare-page grid — exclude unless deliberately exposed.",
  "urlBehavior": {
    "verified": true,
    "samplesTested": { "ball": "Titleist Pro V1", "accessory": "Bridgestone Relaxed B Logo Golf Hat" },
    "bareDefault": "Every product's bare {url}.htm opens on a no-customization default (golf ball = 'None' tile; accessory = 'Stock' tab).",
    "customLogoParam": "?modification=Custom%20Logo deep-links into the Custom Logo customizer for GOLF BALLS only. For accessories the param is IGNORED — the Custom Logo flow lives behind the 'Custom' decoration tab and must be selected explicitly.",
    "modalImplication": "GiftCatalog opens {p.url}.htm today, landing on None/Stock. To open the imprint flow: append ?modification=Custom%20Logo for printTypeGrid (balls); select the 'Custom' tab for accessoryDecorationTabs/inlineDecoration."
  },

  "printTypeUx": {
    "_source": "live golf-ball customizer (Titleist Pro V1), 2026-05-31; see golf-ball-print-types-live.md",
    "entry": "Detail panel 'Looking for other customization types? View All Options' -> inline print-type grid (7 tiles + a 'See All Print Options' tile) -> 'See All Print Options' expands to the full 10 tiles -> clicking any tile opens the editor modal.",
    "modal": "Editor modal ('the popup'): centered title, a 'Print Type' MUI dropdown (10 values), a live ball preview on the left, type-specific controls on the right, Cancel/Save footer. Changing the Print Type dropdown swaps the controls live.",
    "exitsModalOnSelect": ["None", "Custom Logo", "Folds of Honor"],
    "exitNote": "Selecting None clears customization; Custom Logo hands off to the inline page customizer; Folds of Honor applies fixed licensed art. The other 7 edit in-place inside the modal.",
    "resetConfirm": "Changing print type after a customization prompts: 'ARE YOU SURE? Changing your print type will remove your current customization.' [No, Keep It] [Yes, Start Over].",
    "postApply": "Detail panel shows a live 'Print Preview' with 'Edit Personalization' and 'Change Print Type' buttons."
  },

