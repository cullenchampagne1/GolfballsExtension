  "modifications": {
    "Custom Logo": {
      "scope": "universal",
      "verified": true,
      "controls": [
        { "type": "imageUpload", "label": "Upload Your Company Logo", "dropzone": true, "emailFallback": "art@golfballs.com", "designHelp": true },
        { "type": "secondImprintToggle", "label": "Add Second Imprint (Optional)", "reveals": { "choices": ["Add a Second Logo", "Add Personalization"] } }
      ],
      "commercial": { "setupFee": 50, "minQty": 12, "volumeLadder": true, "serviceLevelDropdown": "onBallsOnly" }
    },
    "Personalized": {
      "scope": "golfBall", "corporateScope": false,
      "verified": "live",
      "controls": [
        { "type": "textLine", "label": "Line 1", "required": true, "maxLength": 17 },
        { "type": "textLine", "label": "Optional Line 2", "required": false, "maxLength": 17 },
        { "type": "textLine", "label": "Optional Line 3", "required": false, "maxLength": 17 },
        { "type": "colorPicker", "label": "Color", "palette": "enumerations.colorPalette", "default": "Black" },
        { "type": "fontPicker", "label": "Font", "default": "Kabel Dm BT", "options": ["Kabel Dm BT", "Calibri", "Lucida Handwriting", "Bradley Hand"] },
        { "type": "sizeToggle", "label": "Size", "default": "Standard", "options": ["Standard", "Large", "Max"] }
