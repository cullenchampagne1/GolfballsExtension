      "extras": ["Show AI Suggestions (AI text ideas)", "Add Additional Personalization $5.00/dz (checkbox)"],
      "preview": true
    },
    "Personalized (accessory tab)": {
      "scope": "accessory",
      "verified": true,
      "uiContainer": "Accessory Decoration > Personalized tab",
      "controls": [
        { "type": "textLine", "label": "Line 1" },
        { "type": "colorPicker", "label": "Thread Color", "swatches": ["Black","White","Red","Orange","Grey","Navy","Green","Yellow","Blue","Purple","Pink"] }
