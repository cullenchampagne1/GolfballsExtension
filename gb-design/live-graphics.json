        { "alt": "Margarita", "img": "margarita.png" },
        { "alt": "Cosmopolitan", "img": "cosmopolitan.png" },
        { "alt": "Wine Glass", "img": "wine-glass.png" },
        { "alt": "Beer Mug", "img": "beer-mug-colored.png" },
        { "alt": "Cigar", "img": "cigar.png" }
      ],
      "USA / Patriotic": [
        { "alt": "USA Sunglasses", "img": "usa-sunglasses.png" },
        { "alt": "USA Wordmark", "img": "usa-wordmark.png" },
        { "alt": "USA Flag", "img": "usa-flag.png" },
        { "alt": "Merica", "img": "merica.png" }
      ],
      "Masters": [
        { "alt": "Masters Azalea", "img": "masters-azalea.png" },
        { "alt": "Masters Sweet Tea", "img": "masters-sweet-tea.png" },
        { "alt": "Masters Pimento Cheese", "img": "masters-pimento-cheese.png" },
        { "alt": "Masters Jumpsuit", "img": "masters-jumpsuit.png" }
      ],
      "Misc": [
        { "alt": "Four-leaf Clover", "img": "fourleafclover-full-color.png" },
        { "alt": "Flamingo", "img": "flamingo-colored.png" },
